# Hugging Face Configuration (required for AI Race Engineer LLM)
# Provide access token and choose ONE of:
# - a model id (Hub API)
# - an Inference Endpoint URL
# - a Space backend URL (custom FastAPI app)
#
HUGGINGFACE_TOKEN=hf_your_API_key_here

# Option 1: Call a public or private model by id (Hub API)
HUGGINGFACE_MODEL_ID=athenac22/race_engineer_1
HUGGINGFACE_SPACE_URL=https://athenac22-race_engineer_2.hf.space/chat
HUGGINGFACE_SPACE_SKIP_SSL_VERIFY=true

# Option 2: Use a dedicated Hugging Face Inference Endpoint
# HUGGINGFACE_ENDPOINT_URL=https://your-endpoint.huggingface.cloud

# Option 3: Use a custom Hugging Face Space backend
# (expects POST JSON {\"prompt\", \"max_new_tokens\", \"temperature\"} -> {\"response\"})
# HUGGINGFACE_SPACE_URL=https://username-space-name.hf.space/chat

# Optional: Kokoro Text-to-Speech (for AI voice output, local model)
# KOKORO_VOICE=bm_lewis
# Note: Kokoro model/voice files auto-download and cache on first run.
# Optional: run background model prewarm at app startup (default: true)
# PREWARM_MODELS_ON_START=true
# Note: Speech-to-Text and Text-to-Speech run locally (no API key needed)

# Optional: LiveKit (for future WebRTC integration)
# LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
# LIVEKIT_API_KEY=your_livekit_api_key_here
# LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Optional: LangSmith (for LLM observability)
# LANGSMITH_API_KEY=your_langsmith_api_key_here

# Application Settings
LLM_PROVIDER=huggingface
LOG_LEVEL=INFO
DEBUG=False
